# ===== App =====
APP_NAME=margin-backend
APP_ENV=local
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_BASE_URL=http://localhost:8000
APP_SECRET_KEY=change-me-in-production-please-use-openssl-rand-hex-32
APP_TIMEZONE=Europe/Moscow

# ===== JWT =====
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ===== PostgreSQL =====
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=margin
POSTGRES_USER=margin
POSTGRES_PASSWORD=margin
# Optional override; if empty, built from POSTGRES_* fields:
DATABASE_URL=

# ===== Redis =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=

# ===== Celery =====
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ===== iikoCloud =====
IIKO_API_BASE_URL=https://api-ru.iiko.services/api/1
IIKO_TOKEN_TTL_SECONDS=3300
IIKO_HTTP_TIMEOUT=30
IIKO_RETRY_ATTEMPTS=4

# ===== CORS =====
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ===== Telegram =====
# Bot token from @BotFather. Keep secret — never commit a real token.
TELEGRAM_BOT_TOKEN=
# Bot username WITHOUT '@'. Example: margin_money_bot
TELEGRAM_BOT_USERNAME=
# 'polling' (default, works without a public URL — use locally) or
# 'webhook' (production: Telegram pushes updates to TELEGRAM_WEBHOOK_URL).
TELEGRAM_BOT_MODE=polling
# Public HTTPS origin where Telegram should POST updates. Required for webhook
# mode. Example: https://api.margin.example
TELEGRAM_WEBHOOK_URL=
# Long random string. Telegram includes it as X-Telegram-Bot-Api-Secret-Token
# on every update; we verify it before processing. Generate with:
#   openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_LINK_TOKEN_TTL_MINUTES=15
